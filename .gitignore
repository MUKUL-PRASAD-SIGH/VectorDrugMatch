# Data directories
data/raw/
data/processed/

# Third-party / downloaded data under data/external is never committed (licences + size).
# Everything there is re-creatable: python scripts/fetch_public_data.py --primekg
data/external/*
!data/external/.gitkeep
!data/external/README.md


# Python environment & cache
__pycache__/
*.pyc
venv/
.venv/
env/

# Model outputs & checkpoint files
outputs/
*.pt
*.pkl
*.npy

# Config & local environment
.env

# Jupyter notebooks
.ipynb_checkpoints/

# MLflow tracking (local runs / sqlite stores)
mlruns/
mlflow.db
*.db

# Scratch folder and model weights
ignore/
*.pth
*.zip

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Raw third-party data bundle (DrugBank/DisGeNET-derived)
vdm_real_data/

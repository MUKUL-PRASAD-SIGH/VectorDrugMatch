# Copy to deploy/.env (never commit the real file). All values are read by src/serving/app.py.
VDM_API_KEY=change-me-to-a-long-random-secret     # required; clients send it as the X-API-Key header
VDM_MAX_PAIRS=1000                                # max pairs per /score request
VDM_MAX_TOP_K=500                                 # max top_k per /rank request
VDM_LOG_LEVEL=INFO
# VDM_BUNDLE_DIR is set inside the image (/app/bundle); override only to mount a different, checksummed bundle.
# VDM_ALLOW_NO_AUTH=1                             # local development ONLY; never in staging/production
